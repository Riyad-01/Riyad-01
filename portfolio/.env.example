# Copy to .env.local and fill in. Never commit real values.

# Public site URL (used for canonical URLs, sitemap and social cards)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Riyad AI -------------------------------------------------------------
# Leave ANTHROPIC_API_KEY empty to run in "grounded retrieval" mode:
# answers are composed directly from approved records, with no model call.
ANTHROPIC_API_KEY=
# Model used for generated answers (server-side only).
AI_MODEL=claude-opus-5-5
# Kill switch: set to "off" to disable the AI endpoint entirely.
AI_ENABLED=on
# Per-visitor limits (in-memory by default; see docs/SECURITY_CHECKLIST.md)
AI_RATE_LIMIT_PER_MINUTE=8
AI_RATE_LIMIT_PER_DAY=60
# Global circuit breaker: max generated answers per day across all visitors.
AI_DAILY_BUDGET_REQUESTS=1500

# --- Contact --------------------------------------------------------------
# Optional. With no key, the contact form opens the visitor's email app
# with a prepared message instead of sending from the server.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# --- Analytics ------------------------------------------------------------
# Optional, privacy-conscious. "none" | "plausible"
NEXT_PUBLIC_ANALYTICS_PROVIDER=none
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
